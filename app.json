{
  "expo": {
    "name": "Twsila",
    "slug": "twsila-v2",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/playstore.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.twsila.v2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Twsila to use your location to find shared trips around you."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/logo.png",
        "backgroundColor": "#1F108E"
      },
      "package": "com.twsila.v2",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Twsila V2 to use your location to find nearby trips."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1F108E"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "67ef930e-23c3-4d41-9b0f-7b5400d49c4a"
      }
    }
  }
}
